# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
METRICS_TOKEN=replace-with-at-least-32-random-characters

# ── Database (Supabase Postgres) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/docauto_db
DB_POOL_MAX=10

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
# Use rediss:// (TLS) for Upstash
REDIS_URL=rediss://default:password@host:6379

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI extraction (Week 3-4) — leave unset to use mock classification/extraction ──
ANTHROPIC_API_KEY=
ALLOW_MOCK_PROCESSING=true

# ── Storage driver: 's3', 'supabase', or 'local' ────────────────────────────
# Use 'local' for offline dev (writes to LOCAL_STORAGE_DIR on disk, no cloud creds needed).
# Use 'supabase' for Week 1-2 once Supabase Storage bucket exists, before AWS credentials exist.
STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=./.local-storage

# ── AWS (used when STORAGE_DRIVER=s3, or once Textract is live) ────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Supabase Storage (used when STORAGE_DRIVER=supabase) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=15728640
